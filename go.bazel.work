// Keep deployed REST dependencies at the native go.mod versions. Bazel's Go
// build tools otherwise raise these libraries through the shared module graph.
go 1.25.9

use .

replace golang.org/x/crypto => golang.org/x/crypto v0.50.0
replace golang.org/x/net => golang.org/x/net v0.53.0
replace golang.org/x/sys => golang.org/x/sys v0.43.0
replace golang.org/x/text => golang.org/x/text v0.39.0
